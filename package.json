{
  "name": "spade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prototype:p2": "electron-vite --config prototypes/electron-browser-custom-answer/electron.vite.config.ts --entry prototypes/electron-browser-custom-answer/out/main/index.js",
    "prototype:p2:build": "electron-vite build --config prototypes/electron-browser-custom-answer/electron.vite.config.ts",
    "prototype:p2:typecheck": "tsc --noEmit -p prototypes/electron-browser-custom-answer/tsconfig.node.json && tsc --noEmit -p prototypes/electron-browser-custom-answer/tsconfig.web.json",
    "prototype:p3": "electron-vite --config prototypes/paseo-issue-to-pr-bridge/electron.vite.config.ts --entry prototypes/paseo-issue-to-pr-bridge/out/main/index.js",
    "prototype:p3:build": "electron-vite build --config prototypes/paseo-issue-to-pr-bridge/electron.vite.config.ts",
    "prototype:p3:typecheck": "tsc --noEmit -p prototypes/paseo-issue-to-pr-bridge/tsconfig.node.json && tsc --noEmit -p prototypes/paseo-issue-to-pr-bridge/tsconfig.web.json",
    "prototype:p3:validate:checkout": "npm run prototype:p3:build && node prototypes/paseo-issue-to-pr-bridge/out/main/validateCheckout.js",
    "prototype:p3:validate:paseo": "npm run prototype:p3:build && node prototypes/paseo-issue-to-pr-bridge/out/main/validatePaseo.js",
    "docs:compare": "node scripts/docs-compare.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "npm run build && npm run prototype:p3:build && playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@getpaseo/client": "0.4.0",
    "@xyflow/react": "12.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@swc/core": "1.16.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "marked": "18.0.9",
    "mermaid": "11.16.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "@swc/core@1.16.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
